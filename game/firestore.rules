rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Публичные данные игроков: читать могут вошедшие, писать - только сам игрок в свою запись
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Подписки: id записи = мойUid_чужойUid
    match /follows/{id} {
      allow read: if request.auth != null;
      // создать подписку можно только от своего имени
      allow create: if request.auth != null
        && request.resource.data.follower == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.followed;
      // удалить - только свою подписку
      allow delete: if request.auth != null && resource.data.follower == request.auth.uid;
      allow update: if false;
    }
  }
}
